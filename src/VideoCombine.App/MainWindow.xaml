<Window x:Class="VideoCombine.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VideoCombine" Height="640" Width="960"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Таби верхнього рівня (розділ 4 архітектури). Поки наповнюємо лише «Виконання». -->
        <TabControl Margin="8">
            <TabItem Header="Джерела">
                <Grid Margin="12" DataContext="{Binding Sources}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Єдине поле вставки: одне посилання або пачка по рядках (розділ 3.1). -->
                    <DockPanel Grid.Row="0">
                        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4"
                                   Text="Посилання (одне або кілька, по одному на рядок):" />
                        <TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" Height="70" VerticalScrollBarVisibility="Auto" />
                    </DockPanel>

                    <!-- Дії + вибір якості. -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8">
                        <Button Content="＋ Додати" Width="100" Margin="0,0,8,0"
                                Command="{Binding AddCommand}" />
                        <Button Content="Очистити все" Width="100" Margin="0,0,16,0"
                                Command="{Binding ClearCommand}" />
                        <TextBlock Text="Якість:" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox Width="120" VerticalAlignment="Center"
                                  ItemsSource="{Binding QualityOptions}"
                                  SelectedItem="{Binding Quality}" />
                    </StackPanel>

                    <TextBlock Grid.Row="2" Margin="0,0,0,4" Foreground="Gray"
                               Text="Додані джерела:" />

                    <!-- Список доданих: посилання + статус валідації. -->
                    <Border Grid.Row="3" BorderBrush="#DDD" BorderThickness="1">
                        <ListBox ItemsSource="{Binding Sources}" BorderThickness="0"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Url}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                                                   Foreground="{Binding StatusColor}" Margin="8,0"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Content="✕" Width="24" Height="22"
                                                ToolTip="Видалити"
                                                Command="{Binding DataContext.RemoveCommand,
                                                          RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Конструктор">
                <TextBlock Margin="16" Foreground="Gray"
                           Text="Таб «Конструктор» — Фаза C: список кроків із галочками + панель налаштувань." />
            </TabItem>
            <TabItem Header="Виконання">
                <Grid Margin="12" DataContext="{Binding Execution}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Кнопки керування. Джерела беруться з таба «Джерела». -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="▶ Старт" Width="100" Margin="0,0,8,0"
                                Command="{Binding StartCommand}" />
                        <Button Content="■ Скасувати" Width="100" Margin="0,0,8,0"
                                Command="{Binding CancelCommand}" />
                        <Button Content="📂 Відкрити результат" Width="160"
                                Command="{Binding OpenResultCommand}" />
                    </StackPanel>

                    <!-- Загальний прогрес. -->
                    <StackPanel Grid.Row="1" Margin="0,4">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding OverallText}" Foreground="Gray" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Загальний прогрес" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ElapsedText}" Foreground="#0066CC"
                                           Margin="12,0,0,0" FontWeight="SemiBold" />
                            </StackPanel>
                        </DockPanel>
                        <ProgressBar Height="18" Minimum="0" Maximum="1"
                                     Value="{Binding OverallProgress}" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Прогрес поточного кроку. -->
                    <StackPanel Grid.Row="2" Margin="0,4">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentDetail}"
                                       Foreground="Gray" TextTrimming="CharacterEllipsis" MaxWidth="500" />
                            <TextBlock Text="{Binding CurrentStepName}" FontWeight="SemiBold" />
                        </DockPanel>
                        <ProgressBar Height="14" Minimum="0" Maximum="1"
                                     Value="{Binding StepProgress}" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Лог: рядки з кольоровою позначкою рівня. -->
                    <Border Grid.Row="3" Margin="0,8,0,0" BorderBrush="#DDD" BorderThickness="1">
                        <ListBox ItemsSource="{Binding LogEntries}" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Mark}" Foreground="{Binding Color}"
                                                   FontWeight="Bold" Width="20" />
                                        <TextBlock Text="{Binding Message}" Foreground="{Binding Color}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <TextBlock Grid.Row="4" Margin="0,6,0,0" Foreground="Gray" FontSize="11"
                               Text="Поки фіксований ланцюг: Завантаження → Аналіз → Нарізка (3–8с) → Склейка. Налаштування кроків — у Конструкторі (Фаза C)." />
                </Grid>
            </TabItem>
            <TabItem Header="Налаштування">
                <TextBlock Margin="16" Foreground="Gray"
                           Text="Таб «Налаштування» — Фаза C: шляхи до exe, API-ключі, ліміти, папки." />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
