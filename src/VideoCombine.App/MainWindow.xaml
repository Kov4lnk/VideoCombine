<Window x:Class="VideoCombine.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VideoCombine" Height="640" Width="960"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Видимість полів якість/бітрейт за режимом (IsQualityMode/IsBitrateMode). -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <DockPanel>
        <!-- Таби верхнього рівня (розділ 4 архітектури). Поки наповнюємо лише «Виконання». -->
        <TabControl Margin="8">
            <TabItem Header="Джерела">
                <Grid Margin="12" DataContext="{Binding Sources}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Єдина зона вводу (розділ 3.1): вставити посилання (Enter — додати,
                         Shift+Enter — новий рядок) АБО перетягнути файли. «З диска» — те саме діалогом. -->
                    <DockPanel Grid.Row="0">
                        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4"
                                   Text="Вставте посилання (Enter — додати) або перетягніть відеофайли сюди:" />
                        <TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" Height="70" VerticalScrollBarVisibility="Auto"
                                 AllowDrop="True"
                                 PreviewKeyDown="SourcesInput_PreviewKeyDown"
                                 PreviewDragEnter="SourcesDrop_DragOver"
                                 PreviewDragOver="SourcesDrop_DragOver"
                                 PreviewDrop="SourcesDrop_Drop" />
                    </DockPanel>

                    <!-- Дії + вибір якості. -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8">
                        <Button Content="📄 З диска" Width="100" Margin="0,0,8,0"
                                Command="{Binding AddFromDiskCommand}"
                                ToolTip="Додати локальні відеофайли (без завантаження)" />
                        <Button Content="Очистити все" Width="100" Margin="0,0,16,0"
                                Command="{Binding ClearCommand}" />
                        <TextBlock Text="Якість:" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox Width="120" VerticalAlignment="Center"
                                  ItemsSource="{Binding QualityOptions}"
                                  SelectedItem="{Binding Quality}" />
                    </StackPanel>

                    <!-- Швидке завантаження без подальшої обробки. Команди живуть в Execution
                         (там логіка прогону) — тягнемо через Window, як тулбар рецептів. -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8"
                                DataContext="{Binding DataContext.Execution, RelativeSource={RelativeSource AncestorType=Window}}">
                        <Button Content="⬇ Тільки завантажити" Width="160" Margin="0,0,8,0"
                                Command="{Binding DownloadOnlyCommand}"
                                ToolTip="Скачати відео з посилань у папку Output, без нарізки й склейки" />
                        <Button Content="📂 Папка завантажень" Width="160"
                                Command="{Binding OpenDownloadFolderCommand}"
                                ToolTip="Відкрити папку Output у провіднику" />
                    </StackPanel>

                    <TextBlock Grid.Row="3" Margin="0,0,0,4" Foreground="Gray"
                               Text="Додані джерела:" />

                    <!-- Список доданих: посилання + статус валідації. -->
                    <Border Grid.Row="4" BorderBrush="#DDD" BorderThickness="1">
                        <ListBox ItemsSource="{Binding Sources}" BorderThickness="0"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Url}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                                                   Foreground="{Binding StatusColor}" Margin="8,0"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Content="✕" Width="24" Height="22"
                                                ToolTip="Видалити"
                                                Command="{Binding DataContext.RemoveCommand,
                                                          RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Конструктор">
                <DockPanel>

                    <!-- Тулбар рецептів згори (run-config патерн): вибір зі списку = завантажити,
                         ім'я + Зберегти. Це керування всією конфігурацією, а не крок — тож окрема
                         смужка над кроками, відділена рамкою знизу. DataContext — Recipes
                         (сусід Builder на MainViewModel). -->
                    <Border DockPanel.Dock="Top" Background="#F5F6F8"
                            BorderBrush="#DDE0E4" BorderThickness="0,0,0,1" Padding="16,10"
                            DataContext="{Binding DataContext.Recipes, RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💾 Рецепт:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                                <ComboBox Width="180" VerticalAlignment="Center"
                                          ItemsSource="{Binding Recipes}"
                                          DisplayMemberPath="Name"
                                          SelectedItem="{Binding SelectedRecipe}"
                                          ToolTip="Обрати збережений рецепт — застосується одразу" />

                                <Rectangle Width="1" Margin="14,2" Fill="#DDE0E4" />

                                <TextBox Width="160" VerticalAlignment="Center"
                                         Text="{Binding RecipeName, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Ім'я для збереження поточних налаштувань" />
                                <Button Content="Зберегти" Width="90" Margin="8,0,0,0"
                                        Command="{Binding SaveCommand}" />

                                <TextBlock Text="{Binding Status}" Foreground="#0066CC"
                                           VerticalAlignment="Center" Margin="14,0,0,0"
                                           TextTrimming="CharacterEllipsis" MaxWidth="220" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Кроки пайплайну — головний вміст на всю ширину. DataContext — Builder. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Builder}">
                        <StackPanel Margin="16" MaxWidth="420" HorizontalAlignment="Left">

                            <TextBlock Text="Налаштування кроків пайплайну. Завантаження й Аналіз поки без опцій; якість завантаження — на табі «Джерела»."
                                       Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,12" />

                            <!-- Нарізка (CutStep) -->
                            <TextBlock Text="✂ Нарізка" FontWeight="SemiBold" FontSize="14" Margin="0,4,0,6" />
                            <Grid Margin="8,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Режим:" VerticalAlignment="Center" Margin="0,3" />
                                <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,3" HorizontalAlignment="Left" Width="140"
                                          ItemsSource="{Binding CutModeOptions}" SelectedItem="{Binding CutMode}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Мін, сек:" VerticalAlignment="Center" Margin="0,3" />
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,3" HorizontalAlignment="Left" Width="60"
                                         Text="{Binding CutMinSec, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Макс, сек:" VerticalAlignment="Center" Margin="0,3" />
                                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,3" HorizontalAlignment="Left" Width="60"
                                         Text="{Binding CutMaxSec, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Separator Margin="0,14" />

                            <!-- Апскейл (UpscaleStep) — перший опційний крок -->
                            <TextBlock Text="🔍 Апскейл" FontWeight="SemiBold" FontSize="14" Margin="0,4,0,6" />
                            <StackPanel Margin="8,0,0,0">
                                <CheckBox IsChecked="{Binding UpscaleEnabled}"
                                          Content="Збільшувати роздільність сегментів" />
                                <Grid Margin="0,6,0,0" IsEnabled="{Binding UpscaleEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Множник:" VerticalAlignment="Center" Margin="0,3" />
                                    <ComboBox Grid.Column="1" Margin="0,3" HorizontalAlignment="Left" Width="60"
                                              ItemsSource="{Binding UpscaleScaleOptions}" SelectedItem="{Binding UpscaleScale}" />
                                </Grid>
                                <TextBlock Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Text="FFmpeg-scale (lanczos): просте збільшення без AI. Множник ×2/×4 по кожній осі. Опційний крок — між Нарізкою і Склейкою." />
                            </StackPanel>

                            <Separator Margin="0,14" />

                            <!-- Склейка (AssembleStep) -->
                            <TextBlock Text="🎞 Склейка" FontWeight="SemiBold" FontSize="14" Margin="0,4,0,6" />
                            <Grid Margin="8,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Порядок:" VerticalAlignment="Center" Margin="0,3" />
                                <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,3" HorizontalAlignment="Left" Width="140"
                                          ItemsSource="{Binding AssembleOrderOptions}" SelectedItem="{Binding AssembleOrder}" />

                                <CheckBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,0"
                                          IsChecked="{Binding UseNvenc}"
                                          Content="Кодувати на GPU (NVENC)" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Контейнер:" VerticalAlignment="Center" Margin="0,3" />
                                <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,3" HorizontalAlignment="Left" Width="140"
                                          ItemsSource="{Binding ContainerOptions}" SelectedItem="{Binding Container}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Профіль:" VerticalAlignment="Center" Margin="0,3" />
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                                    <ComboBox Width="200"
                                              ItemsSource="{Binding ProfileOptions}" DisplayMemberPath="Name"
                                              SelectedItem="{Binding SelectedProfile}"
                                              ToolTip="Готовий пресет роздільності/формату під платформу" />
                                    <TextBlock Text="{Binding ProfileResolutionText}" Foreground="Gray"
                                               VerticalAlignment="Center" Margin="10,0,0,0" />
                                </StackPanel>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Формат кадру:" VerticalAlignment="Center" Margin="0,3" />
                                <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,3">
                                    <ComboBox HorizontalAlignment="Left" Width="200"
                                              ItemsSource="{Binding FitModeOptions}"
                                              DisplayMemberPath="Label" SelectedValuePath="Key"
                                              SelectedValue="{Binding FitMode}" />
                                    <TextBlock Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                               Text="Діє, коли формат джерела ≠ цільового. «Обрізати» — без полів, «Вписати» — з полями. Для горизонтального лишено активним на випадок змішаних джерел." />
                                </StackPanel>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Кодування:" VerticalAlignment="Center" Margin="0,3" />
                                <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,3" HorizontalAlignment="Left" Width="180"
                                          ItemsSource="{Binding RateModeOptions}"
                                          DisplayMemberPath="Label" SelectedValuePath="Key"
                                          SelectedValue="{Binding RateMode}" />

                                <!-- Якість: лише в режимі "За якістю". -->
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Якість:" VerticalAlignment="Center" Margin="0,3"
                                           Visibility="{Binding IsQualityMode, Converter={StaticResource BoolToVis}}" />
                                <TextBox Grid.Row="6" Grid.Column="1" Margin="0,3" HorizontalAlignment="Left" Width="60"
                                         Text="{Binding Quality, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{Binding IsQualityMode, Converter={StaticResource BoolToVis}}"
                                         ToolTip="CRF (CPU) / CQ (GPU): менше = краще якість і більший файл" />

                                <!-- Бітрейт: лише в режимі "За бітрейтом". -->
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Бітрейт, кбіт/с:" VerticalAlignment="Center" Margin="0,3"
                                           Visibility="{Binding IsBitrateMode, Converter={StaticResource BoolToVis}}" />
                                <TextBox Grid.Row="7" Grid.Column="1" Margin="0,3" HorizontalAlignment="Left" Width="80"
                                         Text="{Binding VideoBitrateK, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{Binding IsBitrateMode, Converter={StaticResource BoolToVis}}"
                                         ToolTip="Цільовий відеобітрейт — передбачуваний розмір файлу" />

                                <TextBlock Grid.Row="8" Grid.Column="0" Text="Пресет:" VerticalAlignment="Center" Margin="0,3" />
                                <ComboBox Grid.Row="8" Grid.Column="1" Margin="0,3" HorizontalAlignment="Left" Width="140"
                                          ItemsSource="{Binding PresetOptions}" SelectedItem="{Binding EncodePreset}"
                                          ToolTip="CPU: ultrafast…veryslow; GPU: p1…p7. Повільніше = краще стиснення." />
                            </Grid>
                            <TextBlock Margin="8,4,0,0" Foreground="Gray" FontSize="11" TextWrapping="Wrap"
                                       Text="NVENC ~3x швидше за CPU; якщо GPU недоступний — автоматичний відкат на CPU (libx264)." />

                            <Separator Margin="0,14" />

                            <!-- Звук і мовлення: субтитри (робочі, whisper.cpp) + озвучка (заглушка) -->
                            <TextBlock Text="🎙 Звук і мовлення" FontWeight="SemiBold" FontSize="14" Margin="0,4,0,6" />
                            <StackPanel Margin="8,0,0,0">

                                <!-- Субтитри (SubtitleStep) — РОБОЧИЙ опційний крок хвоста -->
                                <TextBlock Text="Субтитри (Whisper)" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <CheckBox IsChecked="{Binding SubtitleEnabled}"
                                          Content="Розпізнати мовлення й зробити субтитри" />
                                <StackPanel Margin="0,6,0,0" IsEnabled="{Binding SubtitleEnabled}">
                                    <CheckBox IsChecked="{Binding SubtitleBurnIn}"
                                              Content="Вписати субтитри в кадр (burn-in)" />
                                    <TextBlock Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                               Text="whisper.cpp транскрибує ФІНАЛЬНЕ відео, кладе .srt поряд. Мова — автовизначення. Burn-in додатково вписує субтитри в кадр (окремий файл _sub). Потрібні шлях до whisper і модель — таб «Налаштування»." />
                                </StackPanel>

                                <!-- Озвучка (TtsStep) — ЗАГЛУШКА: видима, але заблокована -->
                                <TextBlock Text="Озвучка (TTS)" FontWeight="SemiBold" Margin="0,12,0,4" />
                                <Border Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1"
                                        CornerRadius="3" Padding="8" IsEnabled="False" Opacity="0.7">
                                    <StackPanel>
                                        <CheckBox IsChecked="{Binding TtsEnabled}"
                                                  Content="Озвучити текст голосом" />
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Провайдер:" VerticalAlignment="Center" Margin="0,3" />
                                            <ComboBox Grid.Column="1" Margin="0,3" HorizontalAlignment="Left" Width="220"
                                                      ItemsSource="{Binding TtsProviderOptions}"
                                                      DisplayMemberPath="Label" SelectedValuePath="Key"
                                                      SelectedValue="{Binding TtsProvider}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <TextBlock Foreground="#B08000" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"
                                           Text="⚠ Скоро: озвучці потрібен текст (з гілки «сценарій», пізніша фаза) і сховище API-ключів. Основу закладено, крок поки не виконується." />
                            </StackPanel>

                            <!-- Зациклення (LoopifyStep) — ОПЦІЙНИЙ крок хвоста -->
                            <TextBlock Text="🔁 Зациклення" FontWeight="SemiBold" FontSize="14" Margin="0,16,0,6" />
                            <CheckBox IsChecked="{Binding LoopifyEnabled}" Content="Зробити відео безшовним лупом" Margin="0,0,0,6" />
                            <StackPanel IsEnabled="{Binding LoopifyEnabled}">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Режим:" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding LoopifyModeOptions}"
                                              DisplayMemberPath="Display"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding LoopifyMode}" />
                                </Grid>
                                <!-- Тривалість crossfade — актуальна лише для режиму crossfade -->
                                <Grid Margin="0,0,0,4"
                                      IsEnabled="{Binding LoopifyMode, Converter={StaticResource EqualToConverter}, ConverterParameter=crossfade}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Crossfade, с:" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Margin="0,0,6,0"
                                             Text="{Binding LoopifyFadeDuration, StringFormat={}{0:0.#}}" />
                                    <TextBlock Grid.Column="2" Text="(0.5–3 с, дефолт 1 с)" Foreground="Gray" FontSize="11" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                                           Text="Crossfade — плавний перехід, надійний. Reverse — boomerang (відео+реверс), ідеальний луп. Smart-trim — SSIM-пошук схожого кадру (експерим.)." />
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
            <TabItem Header="Виконання">
                <Grid Margin="12" DataContext="{Binding Execution}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Кнопки керування. Джерела беруться з таба «Джерела». -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="▶ Старт" Width="100" Margin="0,0,8,0"
                                Command="{Binding StartCommand}" />
                        <Button Content="■ Скасувати" Width="100" Margin="0,0,8,0"
                                Command="{Binding CancelCommand}" />
                        <Button Content="📂 Відкрити результат" Width="160"
                                Command="{Binding OpenResultCommand}" />
                    </StackPanel>

                    <!-- Загальний прогрес. -->
                    <StackPanel Grid.Row="1" Margin="0,4">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding OverallText}" Foreground="Gray" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Загальний прогрес" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ElapsedText}" Foreground="#0066CC"
                                           Margin="12,0,0,0" FontWeight="SemiBold" />
                            </StackPanel>
                        </DockPanel>
                        <ProgressBar Height="18" Minimum="0" Maximum="1"
                                     Value="{Binding OverallProgress}" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Прогрес поточного кроку. -->
                    <StackPanel Grid.Row="2" Margin="0,4">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentDetail}"
                                       Foreground="Gray" TextTrimming="CharacterEllipsis" MaxWidth="500" />
                            <TextBlock Text="{Binding CurrentStepName}" FontWeight="SemiBold" />
                        </DockPanel>
                        <ProgressBar Height="14" Minimum="0" Maximum="1"
                                     Value="{Binding StepProgress}" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Лог: рядки з кольоровою позначкою рівня. -->
                    <Border Grid.Row="3" Margin="0,8,0,0" BorderBrush="#DDD" BorderThickness="1">
                        <ListBox ItemsSource="{Binding LogEntries}" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Mark}" Foreground="{Binding Color}"
                                                   FontWeight="Bold" Width="20" />
                                        <TextBlock Text="{Binding Message}" Foreground="{Binding Color}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <TextBlock Grid.Row="4" Margin="0,6,0,0" Foreground="Gray" FontSize="11"
                               Text="Ланцюг: Завантаження → Аналіз → Нарізка → [Апскейл] → Склейка → [Субтитри]. У квадратних дужках — опційні кроки (лише якщо увімкнено). Налаштування кроків — на табі «Конструктор»." />
                </Grid>
            </TabItem>
            <TabItem Header="Налаштування">
                <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Settings}">
                    <StackPanel Margin="16" MaxWidth="560" HorizontalAlignment="Left">

                        <TextBlock Text="Шляхи до зовнішніх інструментів і робочі папки. Застосовуються при наступному прогоні."
                                   Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,12" />

                        <!-- Шляхи до exe -->
                        <TextBlock Text="🔧 Інструменти" FontWeight="SemiBold" FontSize="14" Margin="0,4,0,6" />
                        <Grid Margin="8,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="ffmpeg:" VerticalAlignment="Center" Margin="0,3" />
                            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,3"
                                     Text="{Binding FfmpegPath, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Row="0" Grid.Column="2" Content="Огляд…" Width="70" Margin="6,3,0,3"
                                    Command="{Binding BrowseFfmpegCommand}" />
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding FfmpegStatus}" Foreground="{Binding FfmpegStatusColor}"
                                       VerticalAlignment="Center" Margin="8,3,0,3" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="ffprobe:" VerticalAlignment="Center" Margin="0,3" />
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,3"
                                     Text="{Binding FfprobePath, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Row="1" Grid.Column="2" Content="Огляд…" Width="70" Margin="6,3,0,3"
                                    Command="{Binding BrowseFfprobeCommand}" />
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding FfprobeStatus}" Foreground="{Binding FfprobeStatusColor}"
                                       VerticalAlignment="Center" Margin="8,3,0,3" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="yt-dlp:" VerticalAlignment="Center" Margin="0,3" />
                            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,3"
                                     Text="{Binding YtDlpPath, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Row="2" Grid.Column="2" Content="Огляд…" Width="70" Margin="6,3,0,3"
                                    Command="{Binding BrowseYtDlpCommand}" />
                            <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding YtDlpStatus}" Foreground="{Binding YtDlpStatusColor}"
                                       VerticalAlignment="Center" Margin="8,3,0,3" />

                            <!-- Whisper (субтитри): exe whisper.cpp + файл моделі. Опційні — без них лише не ввімкнеш субтитри. -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="whisper:" VerticalAlignment="Center" Margin="0,3" />
                            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,3"
                                     Text="{Binding WhisperPath, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="whisper.cpp (main.exe / whisper-cli.exe) — для субтитрів. Необов'язковий." />
                            <Button Grid.Row="3" Grid.Column="2" Content="Огляд…" Width="70" Margin="6,3,0,3"
                                    Command="{Binding BrowseWhisperCommand}" />
                            <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding WhisperStatus}" Foreground="{Binding WhisperStatusColor}"
                                       VerticalAlignment="Center" Margin="8,3,0,3" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="модель:" VerticalAlignment="Center" Margin="0,3" />
                            <TextBox Grid.Row="4" Grid.Column="1" Margin="0,3"
                                     Text="{Binding WhisperModelPath, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Файл моделі Whisper (напр. ggml-base.bin). Завантажується окремо." />
                            <Button Grid.Row="4" Grid.Column="2" Content="Огляд…" Width="70" Margin="6,3,0,3"
                                    Command="{Binding BrowseWhisperModelCommand}" />
                            <TextBlock Grid.Row="4" Grid.Column="3" Text="{Binding WhisperModelStatus}" Foreground="{Binding WhisperModelStatusColor}"
                                       VerticalAlignment="Center" Margin="8,3,0,3" />
                        </Grid>

                        <Separator Margin="0,14" />

                        <!-- Папки -->
                        <TextBlock Text="📁 Папки" FontWeight="SemiBold" FontSize="14" Margin="0,4,0,6" />
                        <Grid Margin="8,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Робоча:" VerticalAlignment="Center" Margin="0,3" />
                            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,3"
                                     Text="{Binding WorkingRoot, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Row="0" Grid.Column="2" Content="Огляд…" Width="70" Margin="6,3,0,3"
                                    Command="{Binding BrowseWorkingCommand}" />
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding WorkingStatus}" Foreground="{Binding WorkingStatusColor}"
                                       VerticalAlignment="Center" Margin="8,3,0,3" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Вивід:" VerticalAlignment="Center" Margin="0,3" />
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,3"
                                     Text="{Binding OutputRoot, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Row="1" Grid.Column="2" Content="Огляд…" Width="70" Margin="6,3,0,3"
                                    Command="{Binding BrowseOutputCommand}" />
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding OutputStatus}" Foreground="{Binding OutputStatusColor}"
                                       VerticalAlignment="Center" Margin="8,3,0,3" />
                        </Grid>

                        <Separator Margin="0,14" />

                        <!-- API-ключі (розділ 9 / 4.3). Зберігаються захищено (DPAPI), окремо
                             від settings.json і рецептів. Поле — PasswordBox (маскується); саме
                             значення у VM не осідає, лише статус «встановлено/порожньо». -->
                        <TextBlock Text="🔑 API-ключі" FontWeight="SemiBold" FontSize="14" Margin="0,4,0,2" />
                        <TextBlock Text="Зберігаються зашифровано на цій машині, окремо від рецептів. Потрібні для хмарної озвучки та LLM (Фаза D/E)."
                                   Foreground="Gray" TextWrapping="Wrap" Margin="8,0,0,6" />
                        <ItemsControl ItemsSource="{Binding ApiKeys}" Margin="8,0,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                                   VerticalAlignment="Center" />
                                        <PasswordBox x:Name="KeyBox" Grid.Column="1" VerticalContentAlignment="Center" />
                                        <Button Grid.Column="2" Content="Зберегти" Width="80" Margin="6,0,0,0"
                                                Click="SaveApiKey_Click" Tag="{Binding ElementName=KeyBox}" />
                                        <Button Grid.Column="3" Content="Стерти" Width="70" Margin="6,0,0,0"
                                                Command="{Binding DataContext.ClearKeyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                        <TextBlock Grid.Column="4" Text="{Binding StatusText}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                                   Foreground="{Binding StatusColor}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Margin="8,16,0,0">
                            <Button Content="Зберегти" Width="100" Command="{Binding SaveCommand}" />
                            <TextBlock Text="{Binding Status}" Foreground="#0066CC"
                                       VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
